# Copy this file to .env and fill in your values.
#
# Sensitive values (POSTGRES_URL, OPENAI_API_KEY, OPENAI_MINI_API_KEY,
# LANGSMITH_API_KEY) are stored in AWS Secrets Manager for deployed
# environments rather than in .env — see config.py's SecretsManagerSource.
# Set SECRETS_MANAGER_SECRET_ID below to pull them from there instead of
# listing them in this file. Never commit real credentials here.

# Database connection URL
DATABASE_URL=sqlite:///./pipeline.db
# POSTGRES_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json   # json | console

# HTTP client
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Pipeline
BATCH_SIZE=1000

# AWS / S3 — leave the key fields blank to use your local AWS CLI
# credentials or (in ECS) the task's IAM role; only set them if you need a
# specific IAM user's static credentials.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=mf-finance-kb
S3_PREFIX=amfi/nav

# AWS Secrets Manager — set this to load POSTGRES_URL/OPENAI_API_KEY/
# OPENAI_MINI_API_KEY/LANGSMITH_API_KEY (etc.) from a single JSON secret
# instead of listing them in .env. Unset = local .env values only.
# SECRETS_MANAGER_SECRET_ID=fies/prod/app-secrets

# LLM / observability — only needed here if not sourced from Secrets Manager
# OPENAI_API_KEY=
# OPENAI_MINI_API_KEY=
# LANGSMITH_API_KEY=
